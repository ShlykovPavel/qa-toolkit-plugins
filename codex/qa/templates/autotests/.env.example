# Пример настроек стенда: скопируйте в .env и впишите значения.
# .env в гите игнорируется — секреты только туда, сюда только примеры.
#
# Здесь лишь адреса и подключения к БД. Учётки ролей, фронт, мобилка — у каждого
# проекта свои: переменные дописываются под проект, их имена — в config.py
# и в документации слоя.
# ============================================================

# --- Базовый URL тестируемого сервиса ---
BASE_URL=https://api.example.test

# Пример: второй сервис (раскомментируйте вместе с config.py)
# BASE_URL_SECOND_SERVICE=https://second.example.test

# слой: frontend
# --- Базовый URL веб-интерфейса ---
FRONTEND_BASE_URL=https://app.example.test
# /слой

# --- База данных (строка подключения SQLAlchemy) ---
DB_PRIMARY=postgresql+psycopg2://user:pass@host:5432/dbname

# Пример: вторая БД
# DB_SECONDARY=postgresql+psycopg2://user:pass@host:5432/second_db
